---
import Layout from '../layouts/Layout.astro';
import { getCategories } from '../lib/api';
import { categoryLabel } from '../lib/i18n';

let categories: { name: string | null }[] = [];

try {
	categories = (await getCategories()).filter((category) => category.name);
} catch {
	categories = [];
}
---

<Layout
	title="Sivua ei löytynyt - MediaSite"
	description="Hakemaasi sivua ei löytynyt MediaSite-sivustolla."
>
	<main>
		<section class="not-found">
			<div class="panel">
				<p class="code" aria-hidden="true">404</p>
				<p class="eyebrow">Virhe 404</p>
				<h1>Sivua ei löytynyt</h1>
				<p class="lead">
					Hakemaasi sivua ei löyty. Se on ehkä siirretty tai poistettu – tai linkissä on
					pieni kirjoitusvirhe.
				</p>

				<div class="actions">
					<a class="btn btn-primary" href="/">← Takaisin etusivulle</a>
					<a class="btn btn-secondary" href="/">Selaa artikkeleita</a>
				</div>

				{
					categories.length > 0 && (
						<div class="suggestions">
							<h2 class="suggestions-title">Tai selaa kategoriita</h2>
							<ul class="suggestion-list">
								{categories.map((category) => (
									<li>
										<a
											class="chip"
											href={`/categories/${encodeURIComponent(category.name as string)}`}
										>
											{categoryLabel(category.name)}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}

	.not-found {
		display: flex;
		justify-content: center;
	}

	.panel {
		position: relative;
		width: 100%;
		max-width: 640px;
		padding: 3rem 2rem;
		text-align: center;
		background: #ffffff;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		overflow: hidden;
	}

	.code {
		position: absolute;
		top: -0.5rem;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		font-size: clamp(7rem, 22vw, 11rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.05em;
		color: #f3f4f6;
		user-select: none;
		pointer-events: none;
	}

	.eyebrow {
		position: relative;
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #3245ff;
	}

	h1 {
		position: relative;
		margin: 0;
		font-size: clamp(1.75rem, 5vw, 2.25rem);
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: #111827;
	}

	.lead {
		position: relative;
		max-width: 42ch;
		margin: 1rem auto 0;
		color: #6b7280;
	}

	.actions {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.625rem 0.875rem;
		border: 1px solid #121212;
		border-radius: 0;
		font-size: 0.875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.043em;
		line-height: 1.14;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.btn-primary {
		background: #121212;
		color: #ffffff;
	}

	.btn-primary:hover {
		background: #2e302f;
		border-color: #2e302f;
	}

	.btn-secondary {
		background: transparent;
		border-color: #d1d5db;
		color: #111827;
	}

	.btn-secondary:hover {
		border-color: #121212;
	}

	.btn:focus-visible {
		outline: 2px solid #3245ff;
		outline-offset: 2px;
	}

	.suggestions {
		position: relative;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid #e5e7eb;
	}

	.suggestions-title {
		margin: 0 0 0.875rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: #6b7280;
	}

	.suggestion-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		display: inline-block;
		padding: 0.375rem 0.75rem;
		background: #f9fafb;
		border: 1px solid #e5e7eb;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 500;
		color: #374151;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.chip:hover {
		border-color: #121212;
		color: #111827;
	}

	.chip:focus-visible {
		outline: 2px solid #3245ff;
		outline-offset: 2px;
	}

	@media (max-width: 640px) {
		main {
			padding: 2rem 1rem 3rem;
		}

		.panel {
			padding: 2.5rem 1.25rem;
		}

		.actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
