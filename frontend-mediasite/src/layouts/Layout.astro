---
import '../styles/global.scss';

import { getCategories } from '../lib/api';
import Navbar from '../components/Navbar.astro';
import { categoryLabel } from '../lib/i18n';
import { Footer } from 'webcoreui/astro'
const footerCategories = (await getCategories()).filter((category) => category.name);

const footerColumns = [
	{
		title: 'Kategoriat',
		items: footerCategories.map((category) => ({
			name: categoryLabel(category.name),
			href: `/categories/${encodeURIComponent(category.name as string)}`,
		})),
	},
	{
		title: 'Sivusto',
		items: [{ name: 'Etusivu', href: '/', active: true }],
	},
].filter((column) => column.items.length > 0);

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'MediaSite',
	description = 'MediaSite - articles and news',
} = Astro.props;
---

<!doctype html>
<html lang="fi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer
		logo={{ url: '/favicon.svg', alt: 'MediaSite', width: 32, height: 32, eager: true }}
		columns={footerColumns}
		subText={`&copy; ${new Date().getFullYear()} MediaSite`}
		/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		line-height: 1.5;
		color: #111827;
		background: #f9fafb;
	}
</style>